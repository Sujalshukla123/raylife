{% set auth_string = ("{{ username }}:{{ password }}") | b64encode %}
{% set dockerconfig = {
  "auths": {
    "{{ registry_url }}": {
      "username": "{{ username }}",
      "password": "{{ password }}",
      "email": "{{ email }}",
      "auth": auth_string
    }
  }
} | to_json | b64encode %}

apiVersion: v1
kind: Secret
metadata:
  name: regcred
  namespace: {{ namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: {{ dockerconfig }}